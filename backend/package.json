{
  "name": "app-e-commerce",
  "version": "1.0.0",
  "description": "mern App",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server",
  "scripts": {
    "dev": "node --watch server",
    "start": "node server",
    "seed:products": "node scripts/seedRealProducts.js",
    "seed:sale": "node scripts/markProductsOnSale.js",
    "reset:password": "node scripts/resetPassword.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/db.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "app.js",
      "config/**/*.js",
      "controller/**/*.js",
      "middlewares/**/*.js",
      "model/**/*.js",
      "routes/**/*.js",
      "util/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text-summary",
      [
        "lcov",
        {
          "projectRoot": ".."
        }
      ]
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.2",
    "multer": "^2.2.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
