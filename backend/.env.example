PORT=your_port_here
# Format standard: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/dbname
# Si erreur "querySrv ECONNREFUSED _mongodb._tcp.<cluster>.mongodb.net" (résolution DNS SRV bloquée
# par ton réseau/DNS local), utilise plutôt le format de connexion standard avec les hosts explicites
# (mongodb://host1,host2,host3/dbname?replicaSet=...&ssl=true), disponible sur Atlas via
# "Connect" → "Drivers" → "Advanced connection options"
MONGODB_URI=your_mongodb_uri_here
SECRET_KEY=your_jwt_secret_here
CLOUD_NAME=your_cloudinary_cloud_name_here
API_KEY=your_cloudinary_api_key_here
API_SECRET=your_cloudinary_api_secret_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
