# Configuration Kubernetes - Fichier d'exemple
# Copie ce fichier en .env.k8s et remplis tes vraies valeurs
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/redstore
SECRET_KEY=your-secret-key-here
METRICS_TOKEN=redstore-metrics-2026
STRIPE_SECRET_KEY=sk_test_xxx
CLOUD_NAME=your-cloud-name
API_KEY=your-api-key
API_SECRET=your-api-secret
NODE_ENV=production
TRUST_PROXY=1