# Variables lues par docker-compose.yml (copier en .env à la racine).
# Uniquement des valeurs PUBLIQUES : elles finissent dans le bundle JS du frontend.
VITE_STRIPE_PUBLISHABLE_KEY=
# Laisser vide : le frontend appelle /api en relatif, proxifié par Nginx
VITE_API_URL=
# Optionnel : base des liens de réinitialisation de mot de passe (défaut http://localhost:8080)
FRONTEND_URL=
